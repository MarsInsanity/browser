+    /**
+     * The tabs the rail should show: everything when no Space is chosen, and otherwise only
+     * the tabs of the chosen one. Pinned tabs are not filtered — they are shown by their own
+     * mediator and stay visible from every Space, which is what Arc does with Favorites.
+     */
+    private List<Tab> getTabsForActiveSpace(TabModel tabModel) {
+        if (mActiveSpace == null) return tabModel.getRepresentativeTabList();
+        if (!tabModel.getAllTabGroupIds().contains(mActiveSpace)) {
+            // The Space was dissolved, or its last tab closed. Fall back to showing everything
+            // rather than an empty rail with no way out of it.
+            mActiveSpace = null;
+            return tabModel.getRepresentativeTabList();
+        }
+        return tabModel.getTabsInGroup(mActiveSpace);
+    }
+
+    /** Rebuilds the row of Space chips. Cheap, and the set of tab groups can change anywhere. */
+    private void rebuildSpacesBar(TabModel tabModel) {
+        if (mSpacesBar == null) return;
+        mSpacesBar.removeAllViews();
+        mSpacesBar.addView(createSpaceChip(null, "All"));
+        int n = 1;
+        for (Token tabGroupId : tabModel.getAllTabGroupIds()) {
+            String title = tabModel.getTabGroupTitle(tabGroupId);
+            if (title == null || title.isEmpty()) title = "Space " + n;
+            mSpacesBar.addView(createSpaceChip(tabGroupId, title));
+            n++;
+        }
+    }
+
+    private TextView createSpaceChip(@Nullable Token tabGroupId, String label) {
+        TextView chip = new TextView(mContainerView.getContext());
