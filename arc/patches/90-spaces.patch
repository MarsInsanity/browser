+    /**
+     * Whether this row belongs to a Space other than the one being shown, and so should render
+     * as nothing.
+     *
+     * <p>Pinned tabs are never hidden: they are Favorites, shown in their own strip from every
+     * Space. Tabs in no group are hidden while a Space is open, which is what makes a Space
+     * feel like a place rather than a filter.
+     */
+    private boolean isOutsideActiveSpace(ListItem item) {
+        if (mActiveSpace == null) return false;
+        if (TabProperties.isPinnedTab(item.model)) return false;
+        TabModel tabModel = mTabModelSelector.getCurrentModel();
+        if (tabModel == null) return false;
+        int tabId = TabProperties.getTabId(item.model);
+        if (tabId == Tab.INVALID_TAB_ID) return false;
+        Tab tab = tabModel.getTabById(tabId);
+        if (tab == null) return false;
+        return !mActiveSpace.equals(tab.getTabGroupId());
+    }
+
+    /** Shows one Space, or all of them when spaceId is null. */
+    private void applySpace(@Nullable Token spaceId) {
+        mActiveSpace = spaceId;
+        TabModel tabModel = mTabModelSelector.getCurrentModel();
+        if (tabModel != null && spaceId != null && tabModel.getTabGroupCollapsed(spaceId)) {
+            // Entering a Space that was left collapsed would show its header and nothing else.
+            tabModel.setTabGroupCollapsed(spaceId, /* isCollapsed= */ false, /* animate= */ true);
+        }
+        if (mAdapter != null) {
+            // View types are what decide which rows render, so they have to be re-evaluated.
+            mAdapter.notifyDataSetChanged();
+        }
+        refreshSpacesBar();
+    }
+
+    /** The Spaces in chip order: all tabs first, then each group. */
+    private List<Token> spacesInOrder(TabModel tabModel) {
+        List<Token> spaces = new ArrayList<>();
+        spaces.add(null);
+        spaces.addAll(tabModel.getAllTabGroupIds());
+        return spaces;
+    }
+
+    /** Moves to the Space `delta` places along, stopping at either end rather than wrapping. */
+    private void stepSpace(int delta) {
+        TabModel tabModel = mTabModelSelector.getCurrentModel();
+        if (tabModel == null) return;
+        List<Token> spaces = spacesInOrder(tabModel);
+        int current = spaces.indexOf(mActiveSpace);
+        if (current < 0) current = 0;
+        int next = current + delta;
+        if (next < 0 || next >= spaces.size()) return;
+        slideToSpace(spaces.get(next), delta);
+    }
+
+    /**
+     * Changes Space with the list sliding out the way it was pushed and the new one coming in
+     * from the other side, so a swipe reads as moving between places rather than as the
+     * contents of one list being rewritten.
+     */
+    private void slideToSpace(@Nullable Token spaceId, int direction) {
+        int width = mRecyclerView.getWidth();
+        if (width <= 0) {
+            applySpace(spaceId);
+            return;
+        }
+        float travel = width * 0.35f * (direction > 0 ? -1f : 1f);
+        mRecyclerView
+                .animate()
+                .translationX(travel)
+                .alpha(0f)
+                .setDuration(110)
+                .withEndAction(
+                        () -> {
+                            applySpace(spaceId);
+                            mRecyclerView.setTranslationX(-travel);
+                            mRecyclerView
+                                    .animate()
+                                    .translationX(0f)
+                                    .alpha(1f)
+                                    .setDuration(160)
+                                    .start();
+                        })
+                .start();
+    }
+
+    private void refreshSpacesBar() {
+        TabModel tabModel = mTabModelSelector.getCurrentModel();
+        if (tabModel != null) rebuildSpacesBar(tabModel);
+    }
+
+    /** Rebuilds the row of Space chips. Cheap, and the set of groups changes from anywhere. */
+    private void rebuildSpacesBar(TabModel tabModel) {
+        if (mSpacesBar == null) return;
+        mSpacesBar.removeAllViews();
+        if (mActiveSpace != null && !tabModel.getAllTabGroupIds().contains(mActiveSpace)) {
+            mActiveSpace = null;
+        }
+        mSpacesBar.addView(createSpaceChip(null, "All"));
+        int n = 1;
+        for (Token tabGroupId : tabModel.getAllTabGroupIds()) {
+            String title = tabModel.getTabGroupTitle(tabGroupId);
+            if (title == null || title.isEmpty()) title = "Space " + n;
+            mSpacesBar.addView(createSpaceChip(tabGroupId, title));
+            n++;
+        }
+    }
+
+    private TextView createSpaceChip(@Nullable Token tabGroupId, String label) {
+        TextView chip = new TextView(mContainerView.getContext());
+        chip.setText(label);
+        chip.setSingleLine(true);
+        float density = mContainerView.getResources().getDisplayMetrics().density;
+        int padH = Math.round(density * 10);
+        int padV = Math.round(density * 6);
+        chip.setPadding(padH, padV, padH, padV);
+        // Take the text appearance the tab titles beside it use; the bare theme default can
+        // come out dark on the rail's own dark background.
+        chip.setTextAppearance(R.style.TextAppearance_TextMedium_Primary);
+        boolean isActive =
+                tabGroupId == null ? mActiveSpace == null : tabGroupId.equals(mActiveSpace);
+        chip.setAlpha(isActive ? 1.0f : 0.5f);
+        chip.setOnClickListener(v -> applySpace(tabGroupId));
+        return chip;
+    }
+
+    /**
+     * Lets a sideways swipe or a two-finger trackpad scroll over the tab list move between
+     * Spaces, which is how Arc does it.
+     *
+     * <p>Safe to put here: the rail's ItemTouchHelper declares no swipe directions and its
+     * onSwiped is empty, so horizontal gestures over a row mean nothing today. The touch
+     * listener only observes — it never reports the event as handled, so scrolling, dragging
+     * and tapping carry on as before.
+     */
+    private void setupSpaceSwitchGestures(Activity activity, RecyclerView recyclerView) {
+        GestureDetector detector =
+                new GestureDetector(
+                        activity,
+                        new GestureDetector.SimpleOnGestureListener() {
+                            @Override
+                            public boolean onFling(
+                                    MotionEvent start,
+                                    MotionEvent end,
+                                    float velocityX,
+                                    float velocityY) {
+                                if (start == null || end == null) return false;
+                                // Ignore anything that is mostly a vertical scroll.
+                                if (Math.abs(velocityX) < Math.abs(velocityY) * 1.5f) return false;
+                                float travel = end.getX() - start.getX();
+                                float minTravel =
+                                        mContainerView.getResources().getDisplayMetrics().density
+                                                * 48;
+                                if (Math.abs(travel) < minTravel) return false;
+                                stepSpace(travel < 0 ? 1 : -1);
+                                return false;
+                            }
+                        });
+
+        recyclerView.addOnItemTouchListener(
+                new RecyclerView.OnItemTouchListener() {
+                    @Override
+                    public boolean onInterceptTouchEvent(RecyclerView rv, MotionEvent e) {
+                        detector.onTouchEvent(e);
+                        return false;
+                    }
+
+                    @Override
+                    public void onTouchEvent(RecyclerView rv, MotionEvent e) {}
+
+                    @Override
+                    public void onRequestDisallowInterceptTouchEvent(boolean disallow) {}
+                });
+
+        recyclerView.setOnGenericMotionListener(
+                (v, event) -> {
+                    if (event.getAction() != MotionEvent.ACTION_SCROLL) return false;
+                    float horizontal = event.getAxisValue(MotionEvent.AXIS_HSCROLL);
+                    if (horizontal == 0f) return false;
+                    mSpaceScrollAccumulator += horizontal;
+                    if (Math.abs(mSpaceScrollAccumulator) < 1.0f) return false;
+                    stepSpace(mSpaceScrollAccumulator > 0 ? 1 : -1);
+                    mSpaceScrollAccumulator = 0f;
+                    return true;
+                });
+    }
